# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===== Backend API (server/) =====
# Wajib di production. Jika SUPABASE_* kosong di dev, API memakai data demo di memori.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-JANGAN-dipakai-di-frontend"
JWT_SECRET="isi-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="12h"
# Password awal peserta yang dibuat mentor lewat POST /api/participants
DEFAULT_PARTICIPANT_PASSWORD="peserta123"
# Hanya perlu jika frontend & API beda domain (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:3000"
API_PORT=8787

# ===== Frontend =====
# Dev & production sama-sama '/api' (dev lewat proxy Vite ke :8787)
VITE_API_BASE_URL="/api"
